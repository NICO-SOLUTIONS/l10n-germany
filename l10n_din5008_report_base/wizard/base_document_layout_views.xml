<odoo>
    <record id="view_base_document_layout_inherit_din5008_config" model="ir.ui.view">
        <field name="name">base.document.layout.view.inherit.din5008.config</field>
        <field name="model">base.document.layout</field>
        <field name="inherit_id" ref="web.view_base_document_layout" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='report_layout_id']" position="after">
                <field
                    name="l10n_din5008_config"
                    widget="din5008_config"
                    invisible="external_report_layout_id != %(l10n_din5008.external_layout_din5008)d"
                />
            </xpath>
        </field>
    </record>
</odoo>
